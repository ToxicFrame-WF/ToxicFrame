{
  "extends": "@electron-toolkit/tsconfig/tsconfig.node.json",
  "include": [
    "electron.vite.config.*",
    "src/main/**/*",
    "src/preload/**/*",
    // renderer logic files the main process imports (electron-free, shared)
    "src/renderer/src/hotkeys.ts",
    "src/renderer/src/localDay.ts",
    "src/renderer/src/marketTools.ts",
    "src/renderer/src/rivenFair.ts",
    "src/renderer/src/rivenFilter.ts",
    "src/renderer/src/rivenPlan.ts",
    "src/renderer/src/rivens.ts",
    "src/renderer/src/tradeStats.ts"
  ],
  "compilerOptions": {
    "composite": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "types": ["electron-vite/node"]
  }
}
